{
  "name": "dsh-we-media-desk",
  "version": "0.1.0",
  "description": "DeepSeek Harness 自媒体工作台插件：记灵感，一键成稿。",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Renown-72/dsh-we-media-desk.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "files": [
    "src",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
